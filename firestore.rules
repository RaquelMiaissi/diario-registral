rules_version = '2';

// Regras de acesso do banco. É AQUI que mora a separação entre o que é
// público e o que é interno da serventia — não no repositório, que é público.
//
// Princípio: diário oficial aberto pode ser lido por qualquer um; verificação
// do Filtro 1, marcação do que toca a rotina da serventia e qualquer coisa
// reproduzida do INR exigem usuário autenticado.
//
// Escrita: NUNCA pelo cliente. Só pelo Admin SDK (conta de serviço), que
// ignora estas regras. Assim nenhuma chave de escrita precisa existir no
// código nem trafegar por conversa.

service cloud.firestore {
  match /databases/{database}/documents {

    // Acórdãos do CSM. Fonte: DJEN, órgão "Intimação de Acordãos".
    // Diário oficial aberto — leitura livre.
    match /acordaos/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Registro das edições varridas: data, ids, contagem de atos.
    // Os campos internos (assisVerificacao, correcao) NÃO ficam aqui —
    // ver /interno abaixo.
    match /edicoes/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Atos da edição. Leitura livre só quando a fonte é diário oficial.
    // Ato com fonte "INR" reproduz compilação de fornecedor contratado:
    // exige autenticação.
    match /atos/{id} {
      allow read: if resource.data.fonte in ['DEJESP', 'DJEN'];
      allow write: if false;
    }

    // Resultado da conferência paralela — quanto a varredura aberta
    // reproduziu do INR. Número de uso interno.
    match /conferencia/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Tudo que é documento interno do cartório: verificação do Filtro 1,
    // orientação de qualificação, marcação de impacto na serventia.
    match /interno/{documento=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Nada mais é acessível. Coleção nova precisa de regra explícita.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
